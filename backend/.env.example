# PostgreSQL connection string for the Sureki app
DATABASE_URL=postgresql://postgres:password@localhost:5432/sureki
PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
GEMINI_API_KEY=replace-with-your-gemini-key
API_TOKEN=replace-with-your-textlk-api-token
SENDER_ID=replace-with-your-textlk-sender-id
# Optional override if text.lk endpoint changes
TEXTLK_SMS_URL=https://app.text.lk/api/v3/sms/send

# Email Service Configuration (for term marks notifications)
# Gmail is recommended - requires App Password (not regular password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=replace-with-your-email
EMAIL_PASSWORD=replace-with-your-email-password-or-app-password
EMAIL_REPLY_TO=replace-with-your-email


